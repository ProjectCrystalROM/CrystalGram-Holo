# Build output
build/
.gradle/
*.apk
*.aab
*.ap_
*.dex
*.class

# Local machine configuration and secrets.
# local.properties holds sdk.dir, the Telegram api_id / api_hash, and the
# release keystore path/password/alias. None of it may be committed.
# See app/build.gradle.
local.properties

# Signing material. The release key is PKCS12; the others are listed so an
# old or alternative keystore can never be committed by accident. Losing this
# file means no future update can install over an existing copy of the app.
*.keystore
*.jks
*.p12
*.p12.tmp

# Gradle's own signing cache and any local key backups
*.bks
signing/

# Native build trees and downloaded toolchains (large, reproducible)
.tools/
.research/
third_party/*/build/
third_party/*/.git/

# Editor / OS noise
.idea/
*.iml
.DS_Store
Thumbs.db
NUL

# Screenshots and scratch output from device testing
shots/
*.png.tmp

# Superseded wolfSSL build output (replaced by OpenSSL 1.1.1w no-asm).
# Nothing links against it and no script here regenerates it.
third_party/wolfssl/23.2.8568313/
